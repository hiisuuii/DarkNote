<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="DarkNote" Manufacturer="DarkNote" Version="!(bind.FileVersion.DarkNoteExe)" Scope="perUser"
           UpgradeCode="11f2f0d3-3311-4c66-a6e7-ba1c298bc48a">
    <MajorUpgrade DowngradeErrorMessage="A newer version of DarkNote is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="DarkNoteIcon" SourceFile="..\darknote.ico" />
    <Property Id="ARPPRODUCTICON" Value="DarkNoteIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DarkNote" />
      </Directory>
    </StandardDirectory>

    <!-- Files under the user profile can't be a component's key path, so each component keys on an HKCU value. -->
    <Component Id="App" Directory="INSTALLFOLDER" Guid="48ae4f4c-63e8-4309-b353-ad32d3f5566f">
      <File Id="DarkNoteExe" Source="..\DarkNote.exe" KeyPath="no" />
      <RegistryValue Root="HKCU" Key="Software\DarkNote\Install" Name="Path" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
    </Component>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="81e0e791-a625-4c82-b178-c58487c992ea">
      <Shortcut Id="DarkNoteShortcut" Name="DarkNote" Target="[#DarkNoteExe]" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\DarkNote\Install" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="Associations" Directory="INSTALLFOLDER" Guid="e8ff3b94-ec15-46d8-ac1f-eba1d66ec948">
      <RegistryValue Root="HKCU" Key="Software\DarkNote\Install" Name="Associations" Type="integer" Value="1" KeyPath="yes" />

      <RegistryValue Root="HKCU" Key="Software\Classes\DarkNote.txt" Type="string" Value="Text Document" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DarkNote.txt\DefaultIcon" Type="expandable" Value="%SystemRoot%\system32\imageres.dll,-102" />
      <RegistryValue Root="HKCU" Key="Software\Classes\DarkNote.txt\shell\open\command" Type="string" Value="&quot;[#DarkNoteExe]&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\.txt\OpenWithProgids" Name="DarkNote.txt" Type="string" Value="" />

      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\DarkNote.exe" Name="FriendlyAppName" Type="string" Value="DarkNote" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\DarkNote.exe\shell\open\command" Type="string" Value="&quot;[#DarkNoteExe]&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKCU" Key="Software\Classes\Applications\DarkNote.exe\SupportedTypes" Name=".txt" Type="string" Value="" />

      <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\DarkNote.exe" Type="string" Value="[#DarkNoteExe]" />

      <RegistryValue Root="HKCU" Key="Software\DarkNote\Capabilities" Name="ApplicationName" Type="string" Value="DarkNote" />
      <RegistryValue Root="HKCU" Key="Software\DarkNote\Capabilities" Name="ApplicationDescription" Type="string" Value="A lightweight dark-mode Notepad replacement." />
      <RegistryValue Root="HKCU" Key="Software\DarkNote\Capabilities\FileAssociations" Name=".txt" Type="string" Value="DarkNote.txt" />
      <RegistryValue Root="HKCU" Key="Software\RegisteredApplications" Name="DarkNote" Type="string" Value="Software\DarkNote\Capabilities" />
    </Component>

    <!-- WixUI_Minimal minus its license page: Welcome -> Ready to install -> Finish. -->
    <UI Id="DarkNoteUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />
    </UI>
    <UIRef Id="WixUI_Common" />
  </Package>
</Wix>
